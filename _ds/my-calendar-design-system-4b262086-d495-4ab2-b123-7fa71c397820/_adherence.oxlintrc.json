{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "app_update/js/**",
              "components/calendar/**",
              "components/core/**",
              "components/forms/**",
              "components/overlays/**",
              "doc-page.js",
              "ui_kits/calendar/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo Black|Cardo|Cormorant Garamond|Cormorant Infant|Inter|Newsreader|PT Serif|Saira|Share Tech Mono|Spectral|VT323|Work Sans|Playfair Display|Caveat|Audiowide|Chakra Petch|DM Serif Display|Nunito|Libre Baskerville|Source Sans 3|DM Sans|Outfit|Bebas Neue|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo Black, Cardo, Cormorant Garamond, Cormorant Infant, Inter, Newsreader, PT Serif, Saira, Share Tech Mono, Spectral, VT323, Work Sans, Playfair Display, Caveat, Audiowide, Chakra Petch, DM Serif Display, Nunito, Libre Baskerville, Source Sans 3, DM Sans, Outfit, Bebas Neue, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|disabled|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, disabled, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|google|outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'google' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalendarCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:day|outMonth|weekend|today|marked|markColor|goal|note|diary|diaryMood|birthday|holiday|weather|lastRow|onClick|key|ref|className|style|children)$/]",
        "message": "<CalendarCell> doesn't accept that prop. Declared props: day, outMonth, weekend, today, marked, markColor, goal, note, diary, diaryMood, birthday, holiday, weather, lastRow, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalendarGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<CalendarGrid> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|accentColor|children|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, accentColor, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorDotPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|size|key|ref|className|style|children)$/]",
        "message": "<ColorDotPicker> doesn't accept that prop. Declared props: value, onChange, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='DropdownOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|active|onSelect|key|ref|className|style|children)$/]",
        "message": "<DropdownOption> doesn't accept that prop. Declared props: label, active, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|title|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, active, title, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|children|style|key|ref|className|style|children)$/]",
        "message": "<InfoBanner> doesn't accept that prop. Declared props: kind, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoBanner'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:birthday|holiday|weather)$/]",
        "message": "<InfoBanner> kind must be one of 'birthday' | 'holiday' | 'weather'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|subtitle|maxWidth|children|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, onClose, title, subtitle, maxWidth, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonthHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:month|year|onPrev|onNext|onTitleClick|key|ref|className|style|children)$/]",
        "message": "<MonthHeader> doesn't accept that prop. Declared props: month, year, onPrev, onNext, onTitleClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoodPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|label|key|ref|className|style|children)$/]",
        "message": "<MoodPicker> doesn't accept that prop. Declared props: value, onChange, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<PillButton> doesn't accept that prop. Declared props: variant, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:accent|card)$/]",
        "message": "<PillButton> variant must be one of 'accent' | 'card'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatsBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|empty|key|ref|className|style|children)$/]",
        "message": "<StatsBar> doesn't accept that prop. Declared props: items, empty."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextArea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|inkColor|rows|placeholder|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<TextArea> doesn't accept that prop. Declared props: label, inkColor, rows, placeholder, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|type|onChange|style|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: label, placeholder, value, type, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:visible|children|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: visible, children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
